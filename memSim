VALID_FRAME_RANGE = range(1, 257)

BACKING_STORE_FILEPATH = "BACKING_STORE.bin"


class TranslationLookasideBuffer:
    CAPACITY = 16
    
    def __init__(self):
        self.queue = []

    def enqueue(self, entry):
        if len(self.queue) >= self.CAPACITY:
            self.queue.pop(0)
        
        self.queue.append(entry)

    def lookup(self, page_number):
        for entry in self.queue:
            # Checks if in the queue, and valid bit set to 1
            # TODO: Once all bits confirmed, make sure valid bit is in correct location, or change the data structure to hold it
            if page_number in entry and entry[page_number][-1] == 1:
                # TLB hit
                return entry[page_number]
        # TLB miss
        return None


class PageTable:
    CAPACITY = 256

    def __init__(self):
        # Filling the table with default values
        self.table = [(None, 0)] * self.CAPACITY
    
    def lookup(self, page_number):
        entry = self.table[page_number]
        # Checks if the valid bit is set to 1
        # TODO: Once all bits confirmed, make sure valid bit is in correct location, or change the data structure to hold it
        if entry[-1] == 1:
            return entry
        # Page table miss
        return None
    
